# Copy this file to .env and put one of your Gnani API keys (from app.gnani.ai) here.
GNANI_API_KEY=
# Optional: change the Timbre voice (timbre-v2.5 voices, e.g. Nalini, Kaveri, Asmita, Suhana, Poorvi)
BOLKE_TTS_VOICE=Nalini
# Optional: open-ended answers for ANY DSA question, not just the 40 listed
# topics. Any OpenAI-compatible chat API works. Leave these empty to keep
# bank + family-guide answers only.
# Local Ollama example: BOLKE_LLM_BASE_URL=http://localhost:11434/v1
# Cloud example: your provider's OpenAI-compatible base URL (check its docs).
BOLKE_LLM_BASE_URL=
BOLKE_LLM_MODEL=
# Leave empty for local servers without auth; otherwise your provider's key.
BOLKE_LLM_API_KEY=
